title                   = PARP1-LIG@LIGANDO@ MD production 50 ns

integrator              = md
dt                      = 0.002
nsteps                  = 25000000

; Output
nstenergy               = 5000
nstlog                  = 5000
nstxout-compressed      = 5000

; Bonds
constraints             = h-bonds
constraint-algorithm    = lincs

; Neighbor searching
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.0

; Electrostatics
coulombtype             = PME
rcoulomb                = 1.0

; van der Waals
vdwtype                 = cutoff
rvdw                    = 1.0

; Temperature coupling
tcoupl                  = V-rescale
tc-grps                 = System
tau-t                   = 0.1
ref-t                   = 300

; Pressure coupling
pcoupl                  = C-rescale
pcoupltype              = isotropic
tau-p                   = 2.0
ref-p                   = 1.0
compressibility         = 4.5e-5

; Periodic boundary conditions
pbc                     = xyz

; Initial velocities
gen-vel                 = no

; Center of mass motion
nstcomm                 = 100
comm-grps               = System